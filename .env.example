# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_GTM_CONTAINER_ID=

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Redis / queue
REDIS_URL=redis://localhost:6379
TRIMPROOF_GENERATED_DIR=.trimproof-generated

# OpenAI creative asset provider
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-2

# Google Gemini creative asset provider
GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=gemini-3-pro-image

# Optional native-vector provider
RECRAFT_API_KEY=
RECRAFT_ENABLED=false

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_EXPORT_PRICE_ID=
STRIPE_SUBSCRIPTION_PRICE_ID=

# Transactional email
# EMAIL_PROVIDER can be `resend` or `sendgrid`; if omitted, Trim Proof auto-detects from the API key.
EMAIL_PROVIDER=
EMAIL_FROM=
EMAIL_FROM_NAME=Trim Proof
EMAIL_REPLY_TO=
TRIMPROOF_ADMIN_EMAIL=
RESEND_API_KEY=
RESEND_FROM_EMAIL=
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=
SENDGRID_FROM_NAME=Trim Proof

# Prepress
PDFX_LEVEL=PDF/X-1a:2001
DEFAULT_ICC_PROFILE=USWebCoatedSWOP
